{
  "name": "agentgo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @agentgo/desktop dev",
    "typecheck": "pnpm -r --if-present run typecheck && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run && pnpm test:db-baseline",
    "test:db-baseline": "vitest run --config scripts/vitest.config.ts",
    "test:watch": "vitest",
    "build": "pnpm --filter @agentgo/desktop build",
    "pack:win": "pnpm --filter @agentgo/desktop pack:win",
    "dist:win": "pnpm --filter @agentgo/desktop dist:win",
    "smoke:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-desktop.ps1",
    "smoke:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged.ps1",
    "benchmark:verify": "pnpm vitest run packages/evaluation/src/evaluation.test.ts packages/evaluation/src/qualification.test.ts packages/evaluation/src/local-fixture.test.ts packages/evaluation/src/complex-suites.test.ts packages/evaluation/src/holdout-fixture.test.ts packages/evaluation/src/benchmark-runtime.test.ts packages/contracts/src/evaluation.test.ts",
    "benchmark:fixture": "tsx packages/evaluation/src/serve-local-fixture.ts",
    "benchmark:run": "tsx packages/evaluation/src/run-local-benchmark.ts",
    "benchmark:complex": "tsx packages/evaluation/src/run-complex-benchmark.ts",
    "benchmark:holdout": "tsx packages/evaluation/src/run-holdout-benchmark.ts",
    "benchmark:external": "tsx packages/evaluation/src/run-external-openapi-holdout.ts",
    "benchmark:compare": "tsx packages/evaluation/src/compare-benchmark-runs.ts",
    "conformance": "pnpm vitest run packages/domain/src/vulnerabilities/registry.test.ts packages/application/src/coordinator-generic.architecture.test.ts packages/application/src/qualification-boundary.architecture.test.ts packages/application/src/execution-boundary.architecture.test.ts packages/application/src/l2-boundary.architecture.test.ts packages/evaluation/src/qualification.test.ts",
    "recovery": "tsx scripts/recovery-playbook.ts",
    "findings:audit": "tsx scripts/findings-audit.ts",
    "fuzz": "tsx scripts/fuzz-gates.ts",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "db:baseline": "tsx scripts/v1-database-baseline.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
